---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/special-elite/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/window.css';
import '../styles/paper.css';
import '../styles/print.css';
import Head from '../components/Head.astro';
import MenuBar from '../components/MenuBar.astro';
import Dock from '../components/Dock.astro';
import DesktopIcons from '../components/DesktopIcons.astro';

interface Props { title: string; description: string; path: string; ogImage?: string; focus?: string }
const { title, description, path, focus = 'front' } = Astro.props;
---
<!doctype html>
<html lang="en-CA" data-wallpaper="sunset">
  <head>
    <Head title={title} description={description} path={path} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#win">Skip to window</a>
    <MenuBar />
    <main id="desktop" class="desktop">
      <DesktopIcons />
      <div class="windows" data-windows>
        <slot />
      </div>
    </main>
    <Dock current={focus} />
    <slot name="after" />
    <script>
      import '../scripts/wm.ts';
      import '../scripts/clock.ts';
      const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 1200));
      idle(() => import('../scripts/mikey.ts'));
      let askMod: Promise<typeof import('../scripts/ask.ts')> | null = null;
      const loadAsk = () => (askMod ??= import('../scripts/ask.ts'));
      const initAsk = (el: Element) => { if (el.querySelector('[data-ask]')) loadAsk().then((m) => m.mountAsk(el)); };
      document.querySelectorAll('[data-window]').forEach(initAsk);
      document.addEventListener('wos:mount', (e) => initAsk((e as CustomEvent<Element>).detail));
      document.addEventListener('wos:ask', (e) => loadAsk().then((m) => m.ask((e as CustomEvent<{ q: string }>).detail.q)));
      document.addEventListener('click', (e) => {
        if ((e.target as Element).closest('[data-print]')) window.print();
      });
    </script>
  </body>
</html>
