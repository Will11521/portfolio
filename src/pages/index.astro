---
import OsLayout from '../layouts/OsLayout.astro';
import Window from '../components/Window.astro';
import FrontPage from '../components/FrontPage.astro';
import { FRONT_TITLE, FRONT_DESCRIPTION } from '../data/apps';
---
<OsLayout
  title={FRONT_TITLE}
  description={FRONT_DESCRIPTION}
  path="/"
  focus="front"
>
  <Window id="front" title="Front Page" focus closable={false} x={0} y={0} w={760} url="/" pageTitle={FRONT_TITLE}><FrontPage primary /></Window>
</OsLayout>
